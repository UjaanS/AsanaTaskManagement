{
  "name": "asana-operations-command-center",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server/dev.ts",
    "dev:client": "vite",
    "dev:server": "tsx server/cli.ts",
    "dev:web": "vite",
    "dev:api": "tsx server/cli.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "tsx server/preview.ts",
    "start": "tsx server/cli.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "test": "vitest run"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "tsx": "^4.22.3",
    "vitest": "^4.1.7"
  }
}
